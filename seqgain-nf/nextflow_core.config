manifest {
    name = 'seqgain-nf'
    description = 'SEQGAIN analysis with optional reference mapping'
}
params {
    input = null
    outdir = 'results'
    mapped_only = false
}
profiles {
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
        docker.enabled = false
        conda.enabled = false
    }
    conda { conda.enabled = true }
    slurm { process.executor = 'slurm' }
}
process {
    withName: SEQGAIN { cpus = 1; memory = '4 GB'; time = '4h' }
}
